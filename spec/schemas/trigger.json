{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://senseplane.com/schemas/trigger.json",
  "title": "Trigger",
  "oneOf": [
    {
      "$ref": "#/$defs/objects"
    },
    {
      "$ref": "#/$defs/motion"
    },
    {
      "$ref": "#/$defs/sound"
    },
    {
      "$ref": "#/$defs/sensor"
    },
    {
      "$ref": "#/$defs/schedule"
    },
    {
      "$ref": "#/$defs/sequence"
    },
    {
      "$ref": "#/$defs/condition"
    },
    {
      "$ref": "#/$defs/digest"
    }
  ],
  "discriminator": {
    "propertyName": "type"
  },
  "$defs": {
    "objects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "label",
        "on"
      ],
      "properties": {
        "type": {
          "const": "objects"
        },
        "label": {
          "enum": [
            "person",
            "vehicle",
            "animal",
            "airplane",
            "train",
            "boat",
            "traffic_light",
            "fire_hydrant",
            "stop_sign",
            "parking_meter",
            "bench",
            "backpack",
            "umbrella",
            "handbag",
            "tie",
            "suitcase",
            "frisbee",
            "skis",
            "snowboard",
            "ball",
            "kite",
            "baseball_bat",
            "baseball_glove",
            "skateboard",
            "surfboard",
            "tennis_racket",
            "bottle",
            "wine_glass",
            "cup",
            "fork",
            "knife",
            "spoon",
            "bowl",
            "banana",
            "apple",
            "sandwich",
            "orange",
            "broccoli",
            "carrot",
            "hot_dog",
            "pizza",
            "donut",
            "cake",
            "chair",
            "couch",
            "plant",
            "bed",
            "table",
            "toilet",
            "tv",
            "laptop",
            "computer_mouse",
            "remote",
            "keyboard",
            "phone",
            "microwave",
            "oven",
            "toaster",
            "sink",
            "refrigerator",
            "book",
            "clock",
            "vase",
            "scissors",
            "teddy_bear",
            "hair_dryer",
            "toothbrush"
          ]
        },
        "zone": {
          "type": "string"
        },
        "min_count": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "min_duration_s": {
          "type": "number",
          "minimum": 0,
          "default": 0
        },
        "on": {
          "enum": [
            "enter",
            "leave",
            "present",
            "stationary"
          ]
        }
      }
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "motion"
        },
        "zone": {
          "type": "string"
        },
        "min_duration_s": {
          "type": "number",
          "minimum": 0,
          "default": 0
        }
      }
    },
    "sound": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "class"
      ],
      "properties": {
        "type": {
          "const": "sound"
        },
        "class": {
          "enum": [
            "crying",
            "glass_break",
            "alarm",
            "dog",
            "speech_present"
          ]
        },
        "min_duration_s": {
          "type": "number",
          "minimum": 0,
          "default": 0
        }
      }
    },
    "sensor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "sense"
      ],
      "properties": {
        "type": {
          "const": "sensor"
        },
        "sense": {
          "enum": [
            "temperature",
            "humidity"
          ]
        },
        "above": {
          "type": "number"
        },
        "below": {
          "type": "number"
        },
        "rate_per_min": {
          "type": "number"
        },
        "min_duration_s": {
          "type": "number",
          "minimum": 0,
          "default": 0
        }
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "every_min"
      ],
      "properties": {
        "type": {
          "const": "schedule"
        },
        "every_min": {
          "type": "integer",
          "minimum": 5
        }
      }
    },
    "sequence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "steps",
        "within_s"
      ],
      "properties": {
        "type": {
          "const": "sequence"
        },
        "steps": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#"
          }
        },
        "within_s": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "query",
        "test"
      ],
      "description": "Checked by the API on a schedule (ADR 0057): a question about activities and a comparison. Covers absence (no one in the kitchen by 10:00), count, duration and trends (meals below 70 % of usual).",
      "properties": {
        "type": {
          "const": "condition"
        },
        "query": {
          "$ref": "activity-query.json"
        },
        "test": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "value"
          ],
          "properties": {
            "op": {
              "enum": [
                "lt",
                "lte",
                "gt",
                "gte",
                "eq",
                "ne"
              ]
            },
            "value": {
              "type": "number"
            },
            "of": {
              "enum": [
                "value",
                "ratio",
                "delta"
              ],
              "default": "value",
              "description": "Compare the value, or its ratio or difference to what is usual (needs query.compare)"
            }
          }
        },
        "at": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
          "description": "Check once a day at this local time"
        },
        "every_min": {
          "type": "integer",
          "minimum": 5,
          "description": "Check this often (default 10 when `at` is absent)"
        },
        "days": {
          "type": "array",
          "items": {
            "enum": [
              "mon",
              "tue",
              "wed",
              "thu",
              "fri",
              "sat",
              "sun"
            ]
          },
          "description": "Days to check on (default every day)"
        },
        "time_zone": {
          "type": "string",
          "description": "IANA zone for `at` and the question (default the workspace's)"
        }
      }
    },
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "at",
        "items"
      ],
      "description": "A summary sent at a time of day (ADR 0057): each item a question about activities, answered and delivered as one watch.triggered event.",
      "properties": {
        "type": {
          "const": "digest"
        },
        "at": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
        },
        "days": {
          "type": "array",
          "items": {
            "enum": [
              "mon",
              "tue",
              "wed",
              "thu",
              "fri",
              "sat",
              "sun"
            ]
          },
          "description": "Days to check on (default every day)"
        },
        "time_zone": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "query"
            ],
            "properties": {
              "label": {
                "type": "string",
                "maxLength": 80
              },
              "query": {
                "$ref": "activity-query.json"
              }
            }
          }
        }
      }
    }
  }
}
