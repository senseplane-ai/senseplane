{
  "name": "senseplane-monorepo",
  "version": "0.1.3",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "codegen": "pnpm --filter @senseplane/spec codegen",
    "docs:build": "pnpm --filter @senseplane/docs build",
    "check:drift": "pnpm codegen && git diff --exit-code -- spec/schemas spec/brain spec/media/vectors sdk/typescript/src/generated mcp/src/generated api/src/generated brain/src/senseplane_brain/spec",
    "e2e": "node e2e/run.ts",
    "check:version": "node scripts/version.mjs check",
    "check:licenses": "node scripts/check-licenses.mjs"
  }
}
