{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://senseplane.com/schemas/error.json",
  "title": "Error",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "error"
  ],
  "properties": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "request_id"
      ],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "unauthorized",
            "forbidden",
            "forbidden_sense",
            "not_found",
            "validation_failed",
            "quota_exceeded",
            "allowance_exhausted",
            "rate_limited",
            "needs_zone",
            "unsupported_codec",
            "resolution_not_in_plan",
            "source_limit_reached",
            "not_implemented",
            "service_unavailable",
            "internal",
            "idempotency_key_reused",
            "signup_refused",
            "forbidden_role",
            "invite_invalid",
            "conflict",
            "feature_not_available",
            "limit_reached"
          ]
        },
        "message": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        },
        "details": {
          "type": "object"
        }
      }
    }
  }
}
